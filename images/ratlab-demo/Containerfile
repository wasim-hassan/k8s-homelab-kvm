# syntax=docker/dockerfile:1
FROM golang:1.23-alpine AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod ./
COPY *.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/ratlab-demo .

FROM scratch
COPY --from=build /out/ratlab-demo /ratlab-demo
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/ratlab-demo"]
